{
  "manifest_version": 3,
  "name": "PMR Web Runner",
  "version": "1.9.0",
  "description": "Otomatisasi pengisian logsheet DILOC multi-baris dari file .pmr / .json dengan fitur randomize (±1 s/d ±3) dan kontrol kecepatan.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PMR Web Runner",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "icons.js",
        "content.js"
      ]
    }
  ]
}
