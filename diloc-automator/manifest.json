{
  "manifest_version": 3,
  "name": "DILOC Automator",
  "version": "2.2.1",
  "description": "Otomatisasi pengisian e-logsheet DILOC multi-baris dari file .pmr / .json dengan sinkronisasi master Cloud Firestore, Smart Randomizer, Export/Import JSON native, dan proteksi status.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DILOC Automator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://firestore.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "icons.js",
        "content.js"
      ]
    }
  ]
}
